config {
  type: "view",
  schema: "staging",
  description: "Typed and normalised payroll lines. Keeps EVERY raw row (including re-ingested duplicates, VOID lines and test accounts) so that exclusions in the gold layer stay auditable.",
  columns: {
    amount_usd: "Earning amount parsed to NUMERIC. Raw values sometimes contain thousands separators ('2,195.20').",
    amount_usd_raw: "Original text value, kept for the parse assertion.",
    ingestion_rank: "1 = latest ingestion of this payroll_line_id. The payroll export re-sends some lines; only rank 1 is used downstream.",
    is_test_account: "TRUE for synthetic test users (TEST-xxx) that must never reach reporting."
  }
}

-- Every column is cast through STRING first so the model works whether the bronze
-- table was loaded with schema autodetect or as all-STRING.
WITH typed AS (
  SELECT
    TRIM(CAST(payroll_line_id AS STRING))                                   AS payroll_line_id,
    TRIM(CAST(pay_run_id AS STRING))                                        AS pay_run_id,
    UPPER(TRIM(CAST(employee_id AS STRING)))                                AS employee_id,
    NULLIF(UPPER(TRIM(CAST(department_id AS STRING))), '')                  AS department_id,
    SAFE_CAST(CAST(pay_period_start AS STRING) AS DATE)                     AS pay_period_start,
    SAFE_CAST(CAST(pay_period_end AS STRING) AS DATE)                       AS pay_period_end,
    SAFE_CAST(CAST(pay_date AS STRING) AS DATE)                             AS pay_date,
    UPPER(TRIM(CAST(earning_type AS STRING)))                               AS earning_type,
    SAFE_CAST(CAST(hours AS STRING) AS NUMERIC)                             AS hours,
    SAFE_CAST(REPLACE(TRIM(CAST(amount_usd AS STRING)), ',', '') AS NUMERIC) AS amount_usd,
    CAST(amount_usd AS STRING)                                              AS amount_usd_raw,
    UPPER(TRIM(CAST(line_status AS STRING)))                                AS line_status,
    NULLIF(TRIM(CAST(voids_line_id AS STRING)), '')                         AS voids_line_id,
    SAFE_CAST(REPLACE(CAST(_ingested_at AS STRING), ' UTC', '') AS TIMESTAMP) AS ingested_at
  FROM ${ref("payroll_lines")}
)

SELECT
  t.*,
  STARTS_WITH(t.employee_id, 'TEST') AS is_test_account,
  ROW_NUMBER() OVER (
    PARTITION BY t.payroll_line_id
    ORDER BY t.ingested_at DESC
  ) AS ingestion_rank
FROM typed AS t
